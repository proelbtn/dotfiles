# Ghostty configuration

auto-update-channel = tip

# Use the GitHub Dark color scheme.
theme = GitHub Dark

# Use the repository-managed background image.
background-image = ~/.dotfiles/ghostty/background.jpg
background-image-opacity = 0.08
background-image-fit = cover

# Add 24pt of padding around the terminal content.
window-padding-x = 24
window-padding-y = 24
window-padding-balance = true

# Disable most ligatures.
font-feature = -calt, -liga, -dlig

# Reload the configuration with Cmd+R.
keybind = super+r=reload_config

# Hide the mouse cursor while typing.
mouse-hide-while-typing = true

# Integrate tabs into the macOS title bar.
macos-titlebar-style = tabs

window-theme = ghostty
