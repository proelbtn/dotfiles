{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,

  // ref: https://opencode.ai/docs/permissions/
  "permission": {
    "bash": {
      "*": "ask",
      "echo *": "allow",
      "git commit *": "ask",
      "git *": "allow",
      "gh *": "allow",
      "grep *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow"
    },
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  }
}
