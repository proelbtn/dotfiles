{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openrouter/moonshotai/kimi-k2.6",
  // ref: https://opencode.ai/docs/permissions/
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "echo *": "allow",
      "git commit *": "ask",
      "git *": "allow",
      "gh *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "cat *": "allow",
    },
    "write": "allow"
  }
}
