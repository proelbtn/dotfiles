{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openrouter/moonshotai/kimi-k2.6",
  // ref: https://opencode.ai/docs/permissions/
  "permission": {
    "bash": {
      "*": "ask",
      "echo *": "allow",
      "git commit *": "ask",
      "git *": "allow",
      "gh *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "cat *": "allow",
    },
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  }
}
