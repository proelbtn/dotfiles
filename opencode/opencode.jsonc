{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  // ref: https://opencode.ai/docs/permissions/
  "permission": {
    "bash": {
      "*": "ask",
      "basename *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh *": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "grep *": "allow",
      "head *": "allow",
      "id": "allow",
      "jq *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "allow",
      "yq *": "allow"
    },
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  },
  "lsp": {}
}
